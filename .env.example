# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# --- Supabase ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. NEVER prefix with NEXT_PUBLIC_, never expose to the browser.
# Used only in Server Actions / route handlers that must bypass RLS
# (e.g. inviting staff, admin operations).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Local Supabase CLI stack (from `supabase start` output). Same shape as above,
# point NEXT_PUBLIC_SUPABASE_URL / keys at these while developing locally
# instead of the hosted project.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase start`>
# SUPABASE_SERVICE_ROLE_KEY=<from `supabase start`>

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mother's public listen link ---
# Secret used to HMAC-sign the expiring /listen/<token> links sent to mothers on WhatsApp.
# REQUIRED (no default; links fail closed without it). Generate with: openssl rand -base64 32
# Rotating it invalidates all previously sent links.
LISTEN_LINK_SECRET=

# --- WhatsApp Cloud API webhook (required for /api/whatsapp/webhook; no defaults) ---
# Token you type into Meta's webhook setup screen (any long random string).
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App Settings -> Basic); used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Optional, to send replies back via the Graph API:
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Demo mode (OFF by default) ---
# Set to 1 only on a throwaway demo deployment. Enables the shared demo login and
# fake-data mode; leave unset in production.
# DEMO_MODE=1
